# Copy to .env.control and fill in. Environment of the CONTROL PLANE container
# only. Never commit the real file (make sure your .gitignore covers it).

# Shared secret between the data plane and the control plane. Long and
# random; the same value goes into .env.dataplane.
OMNIGATE_INTERNAL_TOKEN=

# Dashboard password and /admin API token. Long and random: at least 16
# characters, or the control plane refuses to start.
OMNIGATE_ADMIN_TOKEN=

# Media provider keys and webhook signing, under the names your config's
# media.upstreams[].api_key_env and *_env fields use. Leave unset the ones
# whose routes you remove from the config.
REPLICATE_API_TOKEN=
FAL_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OMNIGATE_WEBHOOK_SECRET=
MY_APP_WEBHOOK_SECRET=

# Bucket credentials, if media.storage.kind is "s3".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
