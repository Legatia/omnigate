# Copy to .env.dataplane and fill in. Environment of the DATA PLANE container
# only. This is the process that faces the internet, so it gets as little as
# possible: never put the admin token, media provider keys, webhook secrets
# or bucket credentials in this file. Never commit the real file.

# Shared secret between the data plane and the control plane; the same value
# as in .env.control.
OMNIGATE_INTERNAL_TOKEN=

# Keys of the TEXT providers, under the names your config's
# upstreams[].api_key_env fields use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
