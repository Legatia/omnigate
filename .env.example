# Copy to .env and edit. Compose reads this file for the values it puts into
# compose.yaml itself. Nothing in here is a secret; secrets live in
# .env.control and .env.dataplane (see the two .example files next to this
# one).

# Host names the proxy serves. Real DNS names get Let's Encrypt certificates
# automatically; the localhost defaults get certificates from Caddy's own CA.
OMNIGATE_API_HOST=localhost
OMNIGATE_ADMIN_HOST=admin.localhost

# Source ranges allowed to reach the dashboard and admin API (space-separated
# CIDR ranges). The default is everyone; narrow it to your office or VPN.
OMNIGATE_ADMIN_ALLOW=0.0.0.0/0 ::/0

# Memory limits of the two omnigate containers (Docker sizes: 512m, 1g, 2g).
# A container that grows past its limit is killed and restarted. The comment
# at the top of compose.yaml says what each one needs memory for.
OMNIGATE_CONTROL_MEMORY=1g
OMNIGATE_DATAPLANE_MEMORY=1g
