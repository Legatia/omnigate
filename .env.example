# Copy to .env and fill in. .env is ignored by git; never commit it.

# Shared secret between the data plane and the control plane. Long and random.
OMNIGATE_INTERNAL_TOKEN=

# Dashboard password and /admin API token. Long and random.
OMNIGATE_ADMIN_TOKEN=

# Host names the proxy serves. Real DNS names get Let's Encrypt certificates
# automatically; the localhost defaults get certificates from Caddy's own CA.
OMNIGATE_API_HOST=localhost
OMNIGATE_ADMIN_HOST=admin.localhost

# Provider keys, under the names your config's api_key_env fields use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Media provider keys and webhook signing, as named in config/omnigate.example.json.
# Leave unset the ones whose routes you remove from the config.
REPLICATE_API_TOKEN=
FAL_KEY=
ELEVENLABS_API_KEY=
OMNIGATE_WEBHOOK_SECRET=
MY_APP_WEBHOOK_SECRET=

# Bucket credentials, if media.storage.kind is "s3".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
