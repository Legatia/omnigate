{
  "keys": [
    {
      "name": "my-app",
      "key_sha256": "<sha256 hex of the gateway key you hand to the app>",
      "budget_usd": 25.0,
      "budget_period": "monthly",
      "rpm": 600,
      "max_open_jobs": 20,
      "disabled": false,
      "models": [
        "claude",
        "gpt",
        "gemini",
        "image",
        "video",
        "image-sync",
        "speech",
        "gemini-image",
        "gemini-speech",
        "grok-video",
        "gemini-video"
      ],
      "webhook_secret_env": "MY_APP_WEBHOOK_SECRET",
      "max_jobs_per_day": 2000
    }
  ],
  "upstreams": [
    {
      "name": "anthropic",
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    {
      "name": "openai",
      "kind": "openai",
      "base_url": "https://api.openai.com",
      "api_key_env": "OPENAI_API_KEY"
    },
    {
      "name": "gemini",
      "kind": "openai",
      "base_url": "https://generativelanguage.googleapis.com",
      "api_key_env": "GEMINI_API_KEY",
      "v1_path": "/v1beta/openai"
    }
  ],
  "routes": [
    {
      "model": "claude",
      "targets": [
        {
          "upstream": "anthropic",
          "model": "claude-sonnet-5-5",
          "price_in_per_mtok": 2.0,
          "price_cached_in_per_mtok": 0.1,
          "price_out_per_mtok": 10.0
        }
      ]
    },
    {
      "model": "gpt",
      "targets": [
        {
          "upstream": "openai",
          "model": "<openai model id>",
          "price_in_per_mtok": 0.0,
          "price_out_per_mtok": 0.0
        }
      ]
    },
    {
      "model": "gemini",
      "targets": [
        {
          "upstream": "gemini",
          "model": "<gemini model id>",
          "price_in_per_mtok": 0.0,
          "price_out_per_mtok": 0.0
        }
      ]
    }
  ],
  "media": {
    "public_base_url": "https://gateway.example.com",
    "poll_interval_ms": 2000,
    "max_output_bytes": 536870912,
    "max_input_bytes": 1048576,
    "max_open_jobs": 100,
    "max_jobs_per_day": 10000,
    "upstreams": [
      {
        "name": "replicate",
        "kind": "replicate",
        "base_url": "https://api.replicate.com",
        "api_key_env": "REPLICATE_API_TOKEN"
      },
      {
        "name": "fal",
        "kind": "fal",
        "base_url": "https://queue.fal.run",
        "api_key_env": "FAL_KEY"
      },
      {
        "name": "openai-images",
        "kind": "openai_images",
        "base_url": "https://api.openai.com",
        "api_key_env": "OPENAI_API_KEY"
      },
      {
        "name": "elevenlabs",
        "kind": "elevenlabs",
        "base_url": "https://api.elevenlabs.io",
        "api_key_env": "ELEVENLABS_API_KEY"
      },
      {
        "name": "gemini-media",
        "kind": "gemini",
        "base_url": "https://generativelanguage.googleapis.com",
        "api_key_env": "GEMINI_API_KEY"
      },
      {
        "name": "xai-video",
        "kind": "xai_video",
        "base_url": "https://api.x.ai",
        "api_key_env": "XAI_API_KEY"
      },
      {
        "name": "gemini-interactions",
        "kind": "gemini_interactions",
        "base_url": "https://generativelanguage.googleapis.com",
        "api_key_env": "GEMINI_API_KEY"
      }
    ],
    "routes": [
      {
        "model": "image",
        "timeout_s": 300,
        "targets": [
          {
            "upstream": "fal",
            "model": "<fal model id, e.g. owner/model>",
            "price": {
              "per_output_usd": 0.0
            }
          },
          {
            "upstream": "replicate",
            "model": "<owner/name or owner/name:version>",
            "price": {
              "per_output_usd": 0.0
            }
          }
        ]
      },
      {
        "model": "video",
        "timeout_s": 900,
        "targets": [
          {
            "upstream": "fal",
            "model": "<fal video model id>",
            "price": {
              "per_second_usd": 0.0
            },
            "default_seconds": 5,
            "min_seconds": 1,
            "max_seconds": 10
          }
        ]
      },
      {
        "model": "image-sync",
        "targets": [
          {
            "upstream": "openai-images",
            "model": "<openai image model id>",
            "price": {
              "per_output_usd": 0.0
            }
          }
        ],
        "allowed_input": [
          "prompt",
          "size",
          "quality",
          "background",
          "output_format"
        ],
        "price_multipliers": {
          "quality": {
            "low": 1,
            "medium": 4,
            "high": 16,
            "default": 16
          },
          "size": {
            "1024x1024": 1,
            "1024x1536": 1.5,
            "1536x1024": 1.5,
            "default": 1.5
          }
        }
      },
      {
        "model": "speech",
        "cache_ttl_s": 2592000,
        "targets": [
          {
            "upstream": "elevenlabs",
            "model": "<elevenlabs model_id>",
            "price": {
              "per_input_char_usd": 0.0
            }
          }
        ]
      },
      {
        "model": "gemini-image",
        "targets": [
          {
            "upstream": "gemini-media",
            "model": "<gemini image model id>",
            "price": {
              "per_output_usd": 0.0
            }
          }
        ]
      },
      {
        "model": "gemini-speech",
        "cache_ttl_s": 86400,
        "targets": [
          {
            "upstream": "gemini-media",
            "model": "<gemini tts model id>",
            "price": {
              "per_input_char_usd": 0.0
            }
          }
        ]
      },
      {
        "model": "grok-video",
        "timeout_s": 900,
        "targets": [
          {
            "upstream": "xai-video",
            "model": "<xai video model id>",
            "price": {
              "per_second_usd": 0.0
            },
            "default_seconds": 5,
            "min_seconds": 1,
            "max_seconds": 10
          }
        ]
      },
      {
        "model": "gemini-video",
        "timeout_s": 600,
        "targets": [
          {
            "upstream": "gemini-interactions",
            "model": "<gemini omni model id>",
            "price": {
              "per_job_usd": 0.0
            }
          }
        ]
      }
    ],
    "storage": {
      "kind": "s3",
      "endpoint": "https://s3.us-east-1.amazonaws.com",
      "bucket": "<your bucket>",
      "region": "us-east-1",
      "prefix": "omnigate/",
      "access_key_env": "AWS_ACCESS_KEY_ID",
      "secret_key_env": "AWS_SECRET_ACCESS_KEY",
      "presign_ttl_s": 3600
    },
    "webhooks": {
      "secret_env": "OMNIGATE_WEBHOOK_SECRET",
      "allow_private": false,
      "retry_schedule_ms": [
        5000,
        30000,
        120000,
        600000,
        1800000,
        7200000,
        21600000
      ],
      "max_attempts": 8,
      "max_concurrent": 16,
      "max_concurrent_per_key": 4
    }
  },
  "retention": {
    "jobs_days": 30,
    "ledger_ids_days": 3,
    "delete_bucket_objects": true,
    "ledger_days": 90
  }
}
