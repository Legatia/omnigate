# Copy to .env (which git ignores) and fill in.

# Two different random strings, 32 characters or more each. For example:
#   openssl rand -hex 24
# The first is shared by the two processes; the second is the password of
# the dashboard and the admin API.
OMNIGATE_INTERNAL_TOKEN=
OMNIGATE_ADMIN_TOKEN=

# The key of at least one provider omnigate.json names. A route whose
# provider has no key answers with that provider's own "unauthorized".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
